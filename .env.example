# R18: LLM 配置 — 复制本文件为 .env 填实际值
# .env 已在 .gitignore,不会入库

# LLM provider: deepseek | minimax (默认 deepseek)
LLM_PROVIDER=deepseek

# DeepSeek key — 去 https://platform.deepseek.com 拿
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 模型名(默认 deepseek-chat 通用稳定版)
# 想换实验版改这里,不动代码: LLM_MODEL=deepseek-reasoner / LLM_MODEL=deepseek-chat-v4.1 ...
LLM_MODEL=deepseek-chat

# 备用: MiniMax (如果换 LLM_PROVIDER=minimax)
MINIMAX_API_KEY=your-minimax-key-here

# 调试端点开关 (默认关闭)。
# /api/debug/book/<id>/audit 会返回全部书籍的解析质量统计 (短句/CSS残留/页码候选)。
# 生产环境务必留空或设 0;需要排查 import 问题时才临时设 1。
# 即使打开也仍需家长 PIN 鉴权。
# SHADOW_DEBUG=0
