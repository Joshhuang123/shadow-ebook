audio/tts/*
!audio/tts/.gitkeep
*.wav
*.mp3
*.mp4

# Keep structure but ignore contents
data/books/*.json
data/words/*.json
data/words/*.txt
data/grammar/*.json

# 家长数据 + PIN hash (sensitive, NEVER commit)
data/parent/*
!data/parent/.gitkeep

# 书封面(2026-09-30 脱管):这些是出版物封面,属于各自版权方的作品,
# 不该进公开仓库。本地文件照常保留并被 app 读取,只是不再跟踪。
data/covers/

# Phase 3: SQLite DB (runtime state, regenerated on first startup)
data/shadow.db
data/shadow.db-shm
data/shadow.db-wal
data/.migration_marker
data/.parent_migrated
data/books.migrated-*/
data/parent.migrated-*/

# Round 1: Flask session 秘钥 (持久, 不入库) + 日志轮转产物
data/.secret
data/shadow.log
data/shadow.log.*

# Logs
*.log

# Test outputs
.pytest_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Large binaries accidentally dropped in repo root
*.pkg
*.dmg
*.iso

# Node.js
node_modules/

# HTTPS 自签名证书 (本地生成, 不入库)
certs/server.crt
certs/server.key

# R18: 本地 .env(API keys),不入库;.env.example 入库做模板
.env

# scripts/backup.sh 的产物。整份 shadow.db 都在里面(家长 PIN 哈希、全部书目
# 内容、孩子的阅读进度),绝不能进版本库 —— 备份的意义也正在于它是本地私有的。
backups/

